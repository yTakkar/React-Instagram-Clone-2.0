{{#if loggedIn}}
  {{> yHeader}}
{{ else }}
  {{> nHeader}}
{{/if}}

<div class="notes_wrapper developer_page_wrapper">
  <div class="developer_card animate_scale">
    <div class="developer_header">
      <div class="developer_icon_container"><i class="fas fa-code animate_pulse"></i></div>
      <h1>Meet the Developers</h1>
      <p class="developer_tagline">We create modern, highly interactive, and beautifully responsive applications.</p>
    </div>

    <div class="developer_divider"></div>

    <div class="developer_content">
      <p class="developer_intro">
        Vsocial was designed and engineered by an elite group of full-stack developers committed to high performance and beautiful UI. From database normalization to smooth CSS micro-animations, every line of code is written with precision.
      </p>

      <h2 class="section_subtitle">Our Core Competencies</h2>
      <div class="developer_team_grid">
        <div class="team_member_card">
          <div class="member_badge"><i class="fas fa-laptop-code"></i></div>
          <h3>System Architecture</h3>
          <p>Designing scalable RESTful endpoints, handling database caching, session token validation, and robust query logic.</p>
        </div>

        <div class="team_member_card">
          <div class="member_badge"><i class="fas fa-magic"></i></div>
          <h3>Creative UI/UX Design</h3>
          <p>Curating color schemes, layout systems, premium hover animations, and designing accessible interactive flows.</p>
        </div>

        <div class="team_member_card">
          <div class="member_badge"><i class="fas fa-server"></i></div>
          <h3>Real-time Engineering</h3>
          <p>Implementing seamless bi-directional communication channels using web sockets for instant feeds, chats, and notification state streams.</p>
        </div>
      </div>

      <div class="tech_stack_showcase">
        <h3 class="showcase_title">Powered By Modern Technology</h3>
        <div class="tech_badge_grid">
          <span class="tech_badge">Node.js</span>
          <span class="tech_badge">Express</span>
          <span class="tech_badge">React</span>
          <span class="tech_badge">MySQL</span>
          <span class="tech_badge">Socket.io</span>
          <span class="tech_badge">Sass</span>
          <span class="tech_badge">Webpack</span>
        </div>
      </div>
    </div>
  </div>
</div>

{{> footer}}

