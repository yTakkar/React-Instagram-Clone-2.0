{{#if loggedIn}}
  {{> yHeader}}
{{ else }}
  {{> nHeader}}
{{/if}}

<div class="notes_wrapper about_page_wrapper">
  <div class="about_card animate_scale">
    <div class="about_hero">
      <div class="about_logo animate_pulse">
        <img src="/images/favicon/old/instagram.png" alt="Vsocial Logo">
      </div>
      <h1>About Vsocial</h1>
      <p class="about_tagline">Redefining Social Connections with Premium Design and Real-Time Interaction.</p>
    </div>

    <div class="about_divider"></div>

    <div class="about_content">
      <p class="about_desc">
        Vsocial is a next-generation social platform designed to celebrate moments, facilitate deep community interactions, and provide real-time connection spaces. Inspired by modern design languages, it blends vibrant visual cues, dark-mode aesthetics, fluid micro-interactions, and robust security protocols.
      </p>

      <h2 class="section_subtitle">Our Core Pillars</h2>
      <div class="about_pillars_grid">
        <div class="pillar_item">
          <div class="pillar_icon"><i class="fas fa-bolt"></i></div>
          <h3>Reactive Execution</h3>
          <p>Powered by a decoupled frontend architecture ensuring high fluidity, smooth transitions, and instant response.</p>
        </div>

        <div class="pillar_item">
          <div class="pillar_icon"><i class="fas fa-shield-alt"></i></div>
          <h3>Advanced Security</h3>
          <p>Built with robust cryptographic hashing, request validation pipelines, and secure session management paradigms.</p>
        </div>

        <div class="pillar_item">
          <div class="pillar_icon"><i class="fas fa-sync-alt"></i></div>
          <h3>Real-Time Synchronicity</h3>
          <p>Utilizes advanced bi-directional web sockets for seamless message synchronization, status indicators, and live feeds.</p>
        </div>

        <div class="pillar_item">
          <div class="pillar_icon"><i class="fas fa-palette"></i></div>
          <h3>Harmonious Design</h3>
          <p>Tailored HSL theme variables, clean layouts, and responsiveness designed to provide standard visual accessibility.</p>
        </div>
      </div>
    </div>
  </div>
</div>

{{> footer}}

